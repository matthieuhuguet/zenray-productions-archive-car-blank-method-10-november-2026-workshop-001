# 10 November 2026 14:10 - Blender (headless): build the car from Out/car_<ver>.json, subdivide with creases,
# render the 6 views with the reference framing, save the .blend. Run:
#   Blender -b -P Scripts/BlenderSheet.py -- Out/car_V_001.json [zoom]
import bpy, json, sys, math, os
from mathutils import Vector, Matrix

argv = sys.argv[sys.argv.index('--') + 1:]
src = argv[0]; ZOOM = float(argv[1]) if len(argv) > 1 else 2.0
WIRE = len(argv) > 2 and argv[2] == 'wire'
data = json.load(open(src)); k = data['scale']; ver = data['version']
views = json.load(open('Spec/Views.json')); cal = json.load(open('Out/calibration.json'))
COL = {'body': (0.62, 0.63, 0.65, 1), 'glass_windshield': (0.47, 0.48, 0.50, 1), 'glass_side': (0.40, 0.41, 0.43, 1), 'glass_roofglass': (0.36, 0.37, 0.39, 1),
       'wheelwell': (0.10, 0.10, 0.11, 1), 'panel_dark': (0.36, 0.37, 0.39, 1), 'splitter': (0.42, 0.43, 0.45, 1), 'tyre': (0.20, 0.20, 0.21, 1), 'rim': (0.50, 0.51, 0.53, 1)}

bpy.ops.wm.read_factory_settings(use_empty=True)
scene = bpy.context.scene
mats = {}
def mat(name):
    if name not in mats:
        m = bpy.data.materials.new(name); m.diffuse_color = COL.get(name, (0.6, 0.6, 0.6, 1)); mats[name] = m
    return mats[name]

for pname, p in data['parts'].items():
    me = bpy.data.meshes.new(pname)
    me.from_pydata([tuple(c * k for c in v) for v in p['verts']], [], p['faces'])
    me.update()
    names = sorted(set(p['mats']))
    for n in names: me.materials.append(mat(n))
    for poly, n in zip(me.polygons, p['mats']):
        poly.material_index = names.index(n); poly.use_smooth = True
    cr = {tuple(e) for e in p['creases']}
    if cr:
        me.attributes.new('crease_edge', 'FLOAT', 'EDGE'); me.attributes.new('sharp_edge', 'BOOLEAN', 'EDGE')
        me.attributes.new('crease_vert', 'FLOAT', 'POINT')
        ce = [1.0 if tuple(sorted(e.vertices)) in cr else 0.0 for e in me.edges]
        me.attributes['crease_edge'].data.foreach_set('value', ce)
        me.attributes['sharp_edge'].data.foreach_set('value', [c > 0 for c in ce])
        cvs = [0.0] * len(me.vertices)
        for i in p.get('corners', []): cvs[i] = 1.0
        me.attributes['crease_vert'].data.foreach_set('value', cvs)
        print(pname, 'creased edges', int(sum(ce)), 'of', len(ce))
    ob = bpy.data.objects.new(pname, me); scene.collection.objects.link(ob)
    if p.get('subdiv', 0):
        md = ob.modifiers.new('Subdivision', 'SUBSURF'); md.levels = p['subdiv']; md.render_levels = p['subdiv']
    bpy.context.view_layer.objects.active = ob; ob.select_set(True)
    try:
        bpy.ops.object.shade_auto_smooth(angle=math.radians(28))
    except Exception as ex:
        print('auto smooth failed', ex)
    ob.select_set(False)

# ground plane to catch nothing: keep the flat grey background of the reference
scene.render.engine = 'BLENDER_WORKBENCH'
sh = scene.display.shading
sh.light = 'STUDIO'; sh.color_type = 'MATERIAL'; sh.show_cavity = True; sh.cavity_type = 'BOTH'
sh.show_shadows = False; sh.show_object_outline = False
sh.curvature_ridge_factor = 1.2; sh.curvature_valley_factor = 1.4
scene.display.render_aa = '8'
world = bpy.data.worlds.new('W'); scene.world = world
scene.render.film_transparent = False
scene.view_settings.view_transform = 'Standard'
sh.background_type = 'VIEWPORT'; sh.background_color = (0.125, 0.13, 0.14)
if WIRE:
    for ob in scene.objects:
        if ob.type == 'MESH': ob.show_wire = True
    scene.display.shading.show_object_outline = False

AX = {'x': Vector((1, 0, 0)), 'y': Vector((0, 1, 0)), 'z': Vector((0, 0, 1))}
os.makedirs('Out/render', exist_ok=True)
cam_data = bpy.data.cameras.new('cam'); cam_data.type = 'ORTHO'
cam = bpy.data.objects.new('cam', cam_data); scene.collection.objects.link(cam); scene.camera = cam
for name, v in views.items():
    if name.startswith('_'): continue
    x0, y0, x1, y1 = cal[name]['panel']; w, h = x1 - x0, y1 - y0
    R = AX[v['h'][0]] * (1 if v['h'][1] == '+' else -1); U = AX[v['v']]
    B = R.cross(U)
    cu = (w / 2 - v['ox']) / v['a']; cv = (v['oy'] - h / 2) / v['a']     # panel centre in wu along R and U
    centre = (R * cu + U * cv) * k
    cam.matrix_world = Matrix((R.to_4d(), U.to_4d(), B.to_4d(), (centre + B * 30).to_4d())).transposed()
    cam.matrix_world[3][3] = 1.0
    cam_data.ortho_scale = max(w, h) / v['a'] * k
    cam_data.clip_start = 0.1; cam_data.clip_end = 100
    scene.render.resolution_x = int(w * ZOOM); scene.render.resolution_y = int(h * ZOOM); scene.render.resolution_percentage = 100
    scene.render.filepath = os.path.abspath(f"Out/render/{ver}_{name}{'_wire' if WIRE else ''}.png")
    bpy.ops.render.render(write_still=True)
if not WIRE:
    bpy.ops.wm.save_as_mainfile(filepath=os.path.abspath(f'Out/car_{ver}.blend'))
print('RENDER_DONE')
