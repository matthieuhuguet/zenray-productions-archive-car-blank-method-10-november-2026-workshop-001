# 10 November 2026 12:00 - contrast-enhanced zoom of one region of one view, with a labelled 10 px grid.
# usage: python3 Scripts/Zoom.py <view> x0 y0 x1 y1 [zoom] -> Out/zoom_<view>_<x0>_<y0>.png
import sys, json
import numpy as np
from PIL import Image, ImageDraw, ImageFilter, ImageOps
view, x0, y0, x1, y1 = sys.argv[1], *map(int, sys.argv[2:6])
Z = int(sys.argv[6]) if len(sys.argv) > 6 else 5
cal = json.load(open('Out/calibration.json'))
px0, py0, px1, py1 = cal[view]['panel']
im = Image.open('Ref/Car6Views.png').convert('RGB').crop((px0 + x0, py0 + y0, px0 + x1, py0 + y1))
im = ImageOps.autocontrast(im, cutoff=0.5)
big = im.resize(((x1 - x0) * Z, (y1 - y0) * Z), Image.BICUBIC).filter(ImageFilter.UnsharpMask(radius=4, percent=160))
dr = ImageDraw.Draw(big)
for gx in range((x0 // 10) * 10, x1 + 1, 10):
    if gx < x0: continue
    X = (gx - x0) * Z
    dr.line([(X, 0), (X, big.size[1])], fill=(255, 70, 70) if gx % 50 == 0 else (255, 170, 170), width=1)
    if gx % 20 == 0:
        dr.text((X + 2, 1), str(gx), fill=(255, 255, 0)); dr.text((X + 2, big.size[1] - 11), str(gx), fill=(255, 255, 0))
for gy in range((y0 // 10) * 10, y1 + 1, 10):
    if gy < y0: continue
    Y = (gy - y0) * Z
    dr.line([(0, Y), (big.size[0], Y)], fill=(60, 200, 255) if gy % 50 == 0 else (160, 220, 255), width=1)
    dr.text((1, Y + 1), str(gy), fill=(255, 255, 0)); dr.text((big.size[0] - 22, Y + 1), str(gy), fill=(255, 255, 0))
out = f'Out/zoom_{view}_{x0}_{y0}.png'; big.save(out); print(out, big.size)
