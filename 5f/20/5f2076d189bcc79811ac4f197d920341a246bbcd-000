# 10 November 2026 17:20 - V_003 = V_002 + floor hidden behind the sill, true arch radius (no subdivision any more),
# splitter, struts, rear valance and fins as parametric boxes.
import json, math
s = json.load(open('Spec/V_002.json')); P = s['points']
floor = {1: 31, 2: 31, 3: 31, 4: 31, 5: 31, 6: 31, 7: 31, 8: 31, 9: 33, 10: 38, 11: 49, 12: 53, 13: 50, 14: 44, 15: 38, 16: 32}
for st, z in floor.items():
    for r in (9, 10, 11, 12): P[f'{st},{r}'][2] = float(z)
for st in (7, 8, 9): P[f'{st},8'][2] = max(P[f'{st},8'][2], floor[st] + 1.0)
for a in s['arches'].values():
    keys = [(a['s0'], 8), (a['s0'], 7), (a['s0'], 6)] + [(q, 6) for q in range(a['s0'] + 1, a['s1'])] + [(a['s1'], 6), (a['s1'], 7), (a['s1'], 8)]
    for i, k in enumerate(keys):
        ang = math.radians(a['a0'] + (a['a1'] - a['a0']) * i / (len(keys) - 1))
        P[f'{k[0]},{k[1]}'] = [a['xc'] + a['r'] * math.cos(ang), a['y'], a['zc'] + a['r'] * math.sin(ang)]
s['extras'] = [
    {'name': 'splitter', 'kind': 'box', 'bounds': [3, 68, -128, 128, 19, 24], 'n': [4, 16, 1], 'sweep': 14.0, 'tip_rise': 4.0, 'mat': 'splitter'},
    {'name': 'strut_c', 'kind': 'box', 'bounds': [12, 18, -1.5, 1.5, 24, 34], 'n': [1, 1, 2], 'mat': 'splitter'},
    {'name': 'strut_a', 'kind': 'box', 'bounds': [12, 18, 51, 54, 24, 34], 'n': [1, 1, 2], 'mirror': True, 'mat': 'splitter'},
    {'name': 'strut_b', 'kind': 'box', 'bounds': [14, 20, 82, 85, 24, 34], 'n': [1, 1, 2], 'mirror': True, 'mat': 'splitter'},
    {'name': 'rear_valance', 'kind': 'box', 'bounds': [534, 551, -122, 122, 19, 33], 'n': [2, 16, 2], 'mat': 'splitter'},
    {'name': 'rear_fin', 'kind': 'box', 'bounds': [536, 552, 116, 123, 26, 60], 'n': [2, 1, 4], 'rake': 6.0, 'mirror': True, 'mat': 'splitter'},
]
s['meta']['version'] = 'V_003'
json.dump(s, open('Spec/V_003.json', 'w'), indent=0)
