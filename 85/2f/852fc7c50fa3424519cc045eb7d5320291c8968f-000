# 10 November 2026 14:20 - reference sheet (left) next to the model rendered with the same 6 framings (right).
# usage: python3 Scripts/Compose.py V_001 [wire] -> Sheets/compare_<ver>[_wire].png
import json, sys
from PIL import Image, ImageDraw
ver = sys.argv[1]; suf = '_wire' if len(sys.argv) > 2 else ''
cal = json.load(open('Out/calibration.json'))
ref = Image.open('Ref/Car6Views.png').convert('RGB')
mod = Image.new('RGB', ref.size, (32, 33, 36))
for name, c in cal.items():
    x0, y0, x1, y1 = c['panel']
    r = Image.open(f'Out/render/{ver}_{name}{suf}.png').convert('RGB').resize((x1 - x0, y1 - y0), Image.LANCZOS)
    mod.paste(r, (x0, y0))
out = Image.new('RGB', (ref.size[0] * 2 + 12, ref.size[1] + 34), (15, 15, 15))
out.paste(ref, (0, 34)); out.paste(mod, (ref.size[0] + 12, 34))
d = ImageDraw.Draw(out); d.text((10, 10), 'REFERENCE', fill=(255, 255, 255)); d.text((ref.size[0] + 22, 10), f'MODEL {ver}{suf}', fill=(255, 255, 255))
out.save(f'Sheets/compare_{ver}{suf}.png'); mod.save(f'Sheets/model_{ver}{suf}.png'); print(out.size)
