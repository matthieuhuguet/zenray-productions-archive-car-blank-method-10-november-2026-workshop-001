#!/bin/zsh
# 10 November 2026 18:30 - one iteration: spec -> final mesh (no modifier) -> score -> Blender render -> compare sheet.
# usage: Scripts/Run.sh V_006 [shell|components]
set -e
cd "$(dirname "$0")/.."
VER=$1; MODE=${2:-shell}
python3 Scripts/Export2.py Spec/$VER.json $MODE
python3 Scripts/Score.py Spec/$VER.json --sheet
/Applications/Blender.app/Contents/MacOS/Blender -b -P Scripts/BlenderSheet.py -- Out/car_$VER.json 2 2>&1 | grep -E "RENDER_DONE|Error|rror:" || true
python3 Scripts/Compose.py $VER
