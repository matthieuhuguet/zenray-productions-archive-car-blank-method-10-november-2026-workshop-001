for name, a in ARCH.items():
    keys = [(a['s0'], 8), (a['s0'], 7), (a['s0'], 6)] + [(s, 6) for s in range(a['s0'] + 1, a['s1'])] + [(a['s1'], 6), (a['s1'], 7), (a['s1'], 8)]
    step = math.radians(abs(a['a1'] - a['a0']) / (len(keys) - 1))
    comp = 6.0 / (4.0 + 2.0 * math.cos(step))      # a creased subdivision curve shrinks a polygon by this factor: push the control points out
    for i, k in enumerate(keys):
        ang = math.radians(a['a0'] + (a['a1'] - a['a0']) * i / (len(keys) - 1))
        rr = a['r'] * (comp if 0 < i < len(keys) - 1 else 1.0)
        P[k] = [a['xc'] + rr * math.cos(ang), a['y'], a['zc'] + rr * math.sin(ang)]
